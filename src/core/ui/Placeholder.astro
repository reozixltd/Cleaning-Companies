---
/** Shown where a photo slot has no file yet: plan paper, a dashed outline and what the photo should be. */
interface Props {
  label: string;
  ratio?: string;
}
const { label, ratio = '4 / 3' } = Astro.props;
---

<div class="placeholder" style={`aspect-ratio: ${ratio}`} role="img" aria-label={`Photo to come: ${label}`}>
  <span>{label}</span>
</div>

<style>
  .placeholder {
    display: grid;
    place-items: center;
    padding: var(--space-4);
    border: var(--wall) dashed var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-ice);
    color: var(--color-ink-muted);
    font-size: var(--text-14);
    text-align: center;
  }
</style>
