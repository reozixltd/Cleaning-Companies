---
/** Shown where a photo slot has no file yet: a tinted panel naming what the photo should be. */
interface Props {
  label: string;
  ratio?: string;
}
const { label, ratio = '4 / 3' } = Astro.props;
---

<div class="placeholder" style={`aspect-ratio: ${ratio}`} role="img" aria-label={`Photo to come: ${label}`}>
  <span>{label}</span>
</div>

<style>
  .placeholder {
    display: grid;
    place-items: center;
    padding: var(--space-4);
    border-radius: var(--radius-card);
    background: var(--color-room);
    color: var(--color-ink);
    font-size: var(--text-18);
    font-weight: var(--weight-bold);
    text-align: center;
  }
</style>
