---
/**
 * One numbered step of the booking request. Steps are a real sequence, so they
 * carry numbers. booking.ts shows one step's body at a time; finished steps
 * collapse to a one-line recap with a Change button.
 */
import Button from '@/core/ui/Button.astro';
import ErrorSummary from '@/core/ui/ErrorSummary.astro';
import Icon from '@/core/ui/Icon.astro';
import type { StepId } from '../state';

interface Props {
  id: StepId;
  n: number;
  title: string;
  intro?: string;
  /** Hide the Continue button (the last step sends instead). */
  last?: boolean;
}

const { id, n, title, intro, last = false } = Astro.props;
const titleId = `step-${id}-title`;
---

<li class="step" data-book-step={id} data-state={n === 1 ? 'current' : 'upcoming'} aria-current={n === 1 ? 'step' : undefined}>
  <div class="step__head">
    <span class="step__num tabular" aria-hidden="true">
      <span class="step__n">{n}</span>
      <Icon name="check" size={18} class="step__tick" />
    </span>
    <h2 id={titleId} class="step__title" tabindex="-1">
      <span class="visually-hidden">Step {n} of 5: </span>{title}
    </h2>
    <p class="step__recap" data-recap hidden></p>
    <button type="button" class="step__edit" data-edit={id} hidden>
      Change<span class="visually-hidden"> {title.toLowerCase()}</span>
    </button>
  </div>
  <div class="step__body" data-step-body hidden={n !== 1}>
    {intro && <p class="step__intro">{intro}</p>}
    <ErrorSummary />
    <slot />
    {!last && (
      <div class="step__actions">
        <Button data-next size="lg">Continue</Button>
      </div>
    )}
  </div>
</li>

<style>
  .step {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: var(--hairline) solid var(--color-line);
    scroll-margin-top: 5rem;
  }
  .step[data-state='current'] {
    border-top: var(--wall) solid var(--color-ink);
  }
  .step__head {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: center;
    column-gap: var(--space-3);
  }
  .step__num {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: var(--hairline) solid var(--color-line);
    border-radius: var(--radius-control);
    color: var(--color-ink-muted);
    font-weight: var(--weight-bold);
    line-height: 1;
  }
  .step__num :global(.step__tick) {
    display: none;
  }
  .step[data-state='current'] .step__num {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-on-ink);
  }
  .step[data-state='done'] .step__num {
    border-color: var(--color-room);
    background: var(--color-room);
    color: var(--color-ink);
  }
  .step[data-state='done'] .step__n {
    display: none;
  }
  .step[data-state='done'] .step__num :global(.step__tick) {
    display: block;
  }
  .step__title {
    font-size: var(--text-22);
    outline-offset: 4px;
  }
  .step[data-state='upcoming'] .step__title {
    color: var(--color-ink-muted);
    font-size: var(--text-18);
    font-weight: var(--weight-medium);
  }
  .step__recap {
    grid-column: 2 / 3;
    grid-row: 2;
    color: var(--color-ink-muted);
  }
  .step__edit {
    grid-column: 3;
    grid-row: 1 / span 2;
    min-height: var(--target);
    padding-inline: var(--space-3);
    border: 0;
    border-radius: var(--radius-control);
    background: transparent;
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
    transition: transform var(--dur-press) var(--ease-out);
  }
  .step__edit:active {
    transform: scale(0.97);
  }
  .step__body {
    display: grid;
    gap: var(--space-5);
  }
  .step__intro {
    font-size: var(--text-18);
  }
  .step__actions {
    display: flex;
  }
  @media (max-width: 479px) {
    .step__actions :global(.btn) {
      flex: 1;
    }
  }
  @media (min-width: 768px) {
    .step__body {
      padding-left: calc(2rem + var(--space-3));
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .step__edit:hover {
      background: var(--color-shade);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .step__edit:active {
      transform: none;
    }
  }
</style>
