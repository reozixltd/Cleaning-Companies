---
/**
 * Walk-through request: who to call, and enough about the site to plan the visit.
 * Wired by ./walkthrough.ts (shared core/forms behaviour); works as a plain form layout without JS.
 */
import Button from '@/core/ui/Button.astro';
import ErrorSummary from '@/core/ui/ErrorSummary.astro';
import Field from '@/core/ui/Field.astro';
import { FLOOR_AREAS, FREQUENCIES } from './walkthrough';

const options = (values: readonly string[]) => values.map((v) => ({ value: v, label: v }));
---

<form class="wt" data-walkthrough-form novalidate>
  <ErrorSummary />
  <fieldset>
    <legend>Who we should call</legend>
    <Field name="company" label="Company name" hint="Or the practice, centre or body corporate." required autocomplete="organization" />
    <div class="wt__pair">
      <Field name="firstName" label="First name" required autocomplete="given-name" />
      <Field name="lastName" label="Last name" required autocomplete="family-name" />
    </div>
    <div class="wt__pair">
      <Field name="phone" label="Phone" type="tel" inputmode="tel" required autocomplete="tel" />
      <Field name="email" label="Work email" type="email" inputmode="email" required autocomplete="email" />
    </div>
  </fieldset>
  <fieldset>
    <legend>The site</legend>
    <Field name="siteAddress" label="Street address" hint="Include the building and level if there is one." required autocomplete="address-line1" />
    <div class="wt__pair wt__pair--postcode">
      <Field name="suburb" label="Suburb" required autocomplete="address-level2" />
      <Field name="postcode" label="Postcode" required autocomplete="postal-code" inputmode="numeric" maxlength={4} />
    </div>
    <Field name="floorArea" label="Approximate floor area" type="select" hint="A rough figure is fine. We measure on the walk-through." required options={options(FLOOR_AREAS)} />
    <Field name="frequency" label="How often you need cleaning" type="select" required options={options(FREQUENCIES)} />
    <Field name="preferredTimes" label="Good times for the walk-through" type="textarea" hint="For example, weekday mornings, or after 5pm." maxlength={300} />
  </fieldset>
  <input name="website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="wt__send">
    <Button type="submit" size="lg">Request a walk-through</Button>
    <p class="wt__privacy">We use these details only to arrange the walk-through and your quote. <a href="/privacy/">Privacy policy</a></p>
  </div>
</form>

<script>
  import { initWalkthroughForms } from './walkthrough';
  initWalkthroughForms();
</script>

<style>
  .wt {
    display: grid;
    gap: var(--space-6);
  }
  /* Keeps the focused summary, and a field reached from its link (with its label and hint), clear of the sticky header. */
  .wt :global([data-error-summary]) {
    scroll-margin-top: calc(var(--space-8) + var(--space-5));
  }
  .wt :global(input),
  .wt :global(select),
  .wt :global(textarea) {
    scroll-margin-top: calc(var(--space-8) * 2 + var(--space-6));
  }
  fieldset {
    display: grid;
    gap: var(--space-4);
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  legend {
    width: 100%;
    margin-bottom: var(--space-4);
    padding: 0 0 var(--space-2);
    border-bottom: var(--hairline) solid var(--color-line);
    font-size: var(--text-18);
    font-weight: var(--weight-bold);
  }
  .wt__pair {
    display: grid;
    gap: var(--space-4);
  }
  .wt__send {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .wt__privacy {
    color: var(--color-ink-muted);
    font-size: var(--text-16);
  }
  @media (min-width: 600px) {
    .wt__pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
    .wt__pair--postcode {
      grid-template-columns: minmax(0, 1fr) 9rem;
    }
  }
</style>
