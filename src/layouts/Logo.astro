---
/** Wordmark with a small floor-plan glyph: one room filled, like the calculator. */
import { business } from '@/config/business';
---

<a class="logo" href="/" aria-label={`${business.tradingName}, home`}>
  <svg class="logo__glyph" viewBox="0 0 32 32" aria-hidden="true">
    <rect class="logo__room" x="4.5" y="4.5" width="12" height="11"></rect>
    <rect class="logo__wall" x="3" y="3" width="26" height="26"></rect>
    <path class="logo__wall" d="M16 3v14M3 17h26"></path>
  </svg>
  <span class="logo__word">{business.shortName}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--target);
    color: var(--color-ink);
    text-decoration: none;
  }
  .logo__glyph {
    width: 28px;
    height: 28px;
  }
  .logo__room {
    fill: var(--color-highlight);
  }
  .logo__wall {
    fill: none;
    stroke: var(--color-ink);
    stroke-width: 3;
  }
  .logo__word {
    font-size: var(--text-22);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-display);
  }
</style>
