---
/** All home cleans as a list: what each is for, how long it takes and where its price starts. */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/sections/PageHeader.astro';
import CtaBand from '@/sections/CtaBand.astro';
import Button from '@/core/ui/Button.astro';
import Photo from '@/core/ui/Photo.astro';
import Icon from '@/core/ui/Icon.astro';
import { business } from '@/config/business';
import { photoSlots, type PhotoSlotName } from '@/config/photo-slots';
import { pricing } from '@/config/pricing';
import { formatMoney } from '@/core/format';
import { fromPrice } from '@/domain/quote';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={`House cleaning services in ${business.region} | ${business.shortName}`}
  description="Regular, deep, end of lease and move-in cleaning for homes in Brisbane's north. See what each clean covers and what it costs."
>
  <PageHeader title="House cleaning services" intro={`Four cleans for homes across ${business.region}. Every price includes GST, supplies and equipment.`} />

  <section class="wrap" aria-label="Cleans">
    <ul class="services" role="list">
      {services.map((s) => {
        const slot = `service-${s.data.service}` as PhotoSlotName;
        return (
          <li class="service">
            <Photo slot={slot} alt={photoSlots[slot]?.alt ?? s.data.title} ratio="3 / 2" sizes="(min-width: 900px) 320px, 100vw" />
            <div class="service__body">
              <h2><a href={`/services/${s.id}/`}>{s.data.title}</a></h2>
              <p>{s.data.summary}</p>
              <dl class="service__facts">
                <div><dt>Suits</dt><dd>{s.data.suits}</dd></div>
                <div><dt>Takes</dt><dd>{s.data.duration}</dd></div>
              </dl>
            </div>
            <div class="service__side">
              <p class="service__price">from <strong class="tabular">{formatMoney(fromPrice(s.data.service, pricing))}</strong></p>
              <Button href={`/book/?service=${s.data.service}`} variant="secondary">Book this clean</Button>
            </div>
          </li>
        );
      })}
    </ul>
    <p class="offices">
      <Icon name="building" size={24} />
      <span>Cleaning an office, clinic or strata building? <a href="/offices/">See office cleaning</a>.</span>
    </p>
    <p class="muted note">From prices are for a 1 bedroom, 1 bathroom home{business.demoMode ? ', and are sample prices' : ''}. <a href="/prices/">See how prices add up</a>.</p>
  </section>

  <CtaBand title="Not sure which clean you need?" text="Call us and describe your home. We'll tell you which clean fits and what it will cost." />
</BaseLayout>

<style>
  .services {
    padding: 0;
    list-style: none;
    border-top: var(--wall) solid var(--color-ink);
  }
  .service {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-bottom: var(--hairline) solid var(--color-line);
  }
  .service__body {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .service h2 {
    font-size: var(--text-28);
  }
  .service h2 a {
    text-decoration: none;
  }
  .service__body > p {
    font-size: var(--text-18);
  }
  .service__facts {
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-16);
  }
  .service__facts div {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: var(--space-3);
  }
  dt {
    color: var(--color-ink-muted);
  }
  dd {
    margin: 0;
  }
  .service__side {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .service__price {
    font-size: var(--text-18);
  }
  .service__price strong {
    font-size: var(--text-28);
  }
  .offices {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    margin-top: var(--space-6);
    font-size: var(--text-18);
  }
  .note {
    margin-top: var(--space-3);
    margin-bottom: var(--space-7);
    font-size: var(--text-16);
  }
  @media (min-width: 900px) {
    .service {
      grid-template-columns: 280px minmax(0, 1fr) auto;
      gap: var(--space-6);
      align-items: start;
    }
    .service__side {
      display: grid;
      justify-items: end;
      text-align: right;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .service h2 a:hover {
      text-decoration: underline;
      text-decoration-thickness: var(--wall);
    }
  }
</style>
