---
/**
 * The hero is the calculator: headline and suburb check on the left, the floor
 * plan and its price on the right, controls under the headline. On phones the
 * order is headline, plan, price, controls.
 */
import FloorPlan from '@/features/plan/FloorPlan.astro';
import PlanControls from '@/features/plan/PlanControls.astro';
import PriceTag from '@/features/pricing/PriceTag.astro';
import SuburbCheck from '@/features/areas/SuburbCheck.astro';
---

<section class="hero" id="plan" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <h1 id="hero-title">Your home, priced room by room.</h1>
      <p class="hero__lead">Add your rooms and choose how often. The price updates as you go, and you can book a time without calling.</p>
      <SuburbCheck />
    </div>
    <div class="hero__plan">
      <FloorPlan id="home-plan" mode="edit" title="Your home. Press a dashed room to add it." />
      <PriceTag />
    </div>
    <div class="hero__controls">
      <PlanControls id="home-plan" />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-6) var(--space-7);
  }
  .hero__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'copy' 'plan' 'controls';
  }
  .hero__copy {
    grid-area: copy;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    align-content: start;
  }
  .hero__lead {
    font-size: var(--text-18);
    color: var(--color-ink-muted);
  }
  .hero__plan {
    grid-area: plan;
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }
  .hero__controls {
    grid-area: controls;
  }
  @media (min-width: 1024px) {
    .hero {
      padding-block: var(--space-6) var(--space-8);
    }
    .hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      grid-template-rows: auto 1fr;
      grid-template-areas: 'copy plan' 'controls plan';
      column-gap: var(--space-8);
      row-gap: var(--space-6);
    }
  }
</style>
