---
/** The four steps after "Choose a time". A real sequence, so it is numbered. */
import { business } from '@/config/business';
import SectionHead from './SectionHead.astro';

const steps = [
  { title: 'Choose a time', text: 'Pick a day and a morning or afternoon arrival window online.' },
  { title: 'We confirm by SMS', text: `You hear from us ${business.confirmPromise}, with your cleaner's name.` },
  { title: 'A reminder the day before', text: 'With your arrival window, so you can leave a key or be home.' },
  { title: 'Tell us how we went', text: 'A link to leave a review after the clean. Missed something? We come back within 24 hours.' },
];
---

<section class="band on-dark" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <SectionHead id="how-title" title="How a booking works" />
    <ol class="steps">
      {steps.map((s) => (
        <li>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .steps li {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: var(--hairline) solid var(--color-line);
    counter-increment: step;
  }
  .steps li::before {
    content: counter(step);
    color: var(--color-ink);
    font-size: var(--text-48);
    font-weight: var(--weight-black);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .steps h3 {
    font-size: var(--text-18);
  }
  .steps p {
    color: var(--color-ink-muted);
  }
  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
