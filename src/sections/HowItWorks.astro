---
/** The four steps after "Choose a time". A real sequence, so it is numbered. */
import { business } from '@/config/business';
import SectionHead from './SectionHead.astro';

const steps = [
  { title: 'Choose a time', text: 'Pick a day and a morning or afternoon arrival window online.' },
  { title: 'We confirm by SMS', text: `You hear from us ${business.confirmPromise}, with your cleaner's name.` },
  { title: 'A reminder the day before', text: 'With your arrival window, so you can leave a key or be home.' },
  { title: 'Tell us how we went', text: 'A link to leave a review after the clean. Missed something? We come back within 24 hours.' },
];
---

<section class="band" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <SectionHead id="how-title" title="How a booking works" />
    <ol class="steps" data-progress style={`--n: ${steps.length}`}>
      {steps.map((s, i) => (
        <li style={`--i: ${i}`}>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* One line runs past the four steps: a quiet track with an ink fill over it. The fill is complete
     unless scroll progress is driving it (.motion), so the list reads the same without the script. */
  .steps {
    --fill: 1;
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  @media screen {
    :global(.motion) .steps {
      --fill: clamp(0, (var(--p) - 0.12) * 2.2, 1);
    }
  }
  /* Phones: down the left side. */
  .steps::before,
  .steps::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: var(--wall);
    background: var(--color-line);
  }
  .steps::after {
    background: var(--color-ink);
    transform: scaleY(var(--fill));
    transform-origin: top left;
  }
  .steps li {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-5);
    counter-increment: step;
  }
  /* Each number darkens as the fill reaches it. 0.55 keeps the quiet state above 3:1 for large text. */
  .steps li::before {
    content: counter(step);
    font-size: var(--text-36);
    font-weight: var(--weight-bold);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    opacity: clamp(0.55, 0.55 + var(--fill) * var(--n) - var(--i), 1);
  }
  .steps h3 {
    font-size: var(--text-18);
  }
  .steps p {
    color: var(--color-ink-muted);
  }
  /* From 768px: across the top. */
  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .steps::before,
    .steps::after {
      right: 0;
      bottom: auto;
      width: auto;
      height: var(--wall);
    }
    .steps::after {
      transform: scaleX(var(--fill));
    }
    .steps li {
      padding-left: 0;
      padding-top: var(--space-4);
    }
  }
</style>
