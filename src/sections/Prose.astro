---
/** Long-form text rendered from Markdown (service and area bodies, policies) at a readable measure. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['prose', className]}><slot /></div>

<style>
  .prose {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
  }
  .prose :global(h2) {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: var(--hairline) solid var(--color-line);
    font-size: var(--text-22);
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-5);
  }
  .prose :global(li::marker) {
    color: var(--color-ink-muted);
  }
</style>
