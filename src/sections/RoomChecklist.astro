---
/**
 * "What we clean, room by room": the same plan, read-only. Choosing a room shows
 * its checklist for the service the visitor picked. Every list is rendered at
 * build time (readable without JavaScript and by search engines); the script only
 * decides which one shows.
 */
import { ROOM_KINDS, rooms } from '@/config/rooms';
import { SERVICE_IDS, SERVICE_LABELS } from '@/config/pricing';
import { checklistFor } from '@/domain/checklist';
import FloorPlan from '@/features/plan/FloorPlan.astro';
import RoomStage from '@/features/stage/RoomStage.astro';
import Icon from '@/core/ui/Icon.astro';
import SectionHead from './SectionHead.astro';
---

<section class="band" id="whats-included" aria-labelledby="included-title">
  <div class="wrap">
    <SectionHead id="included-title" title="What we clean, room by room" intro="Choose a room on the plan. Deep and end of lease cleans add more to every list." />
    <div class="included__track">
      <div class="included" data-stage-pin>
        <div class="included__plan">
          <div class="included__map">
            <FloorPlan id="included-plan" mode="read" title="Your home. Choose a room to see its checklist." selected="kitchen" />
          </div>
          <RoomStage />
        </div>
        <div class="included__lists" data-room-panels>
          {SERVICE_IDS.flatMap((service) =>
            ROOM_KINDS.map((kind) => (
              <div class="panel" data-room-panel data-room-kind={kind} data-service={service} hidden={!(kind === 'kitchen' && service === 'regular')}>
                <h3>{rooms.rooms[kind].label}</h3>
                <p class="panel__service">{SERVICE_LABELS[service]}</p>
                <ul role="list">
                  {checklistFor(kind, service, rooms).map((item) => (
                    <li><Icon name="check" size={20} />{item}</li>
                  ))}
                </ul>
              </div>
            )),
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { getStorage } from '@/core/storage';
  import { pricing } from '@/config/pricing';
  import { rooms } from '@/config/rooms';
  import { onSelection } from '@/domain/events';
  import { loadSelection } from '@/domain/selection';
  import { ROOM_EVENT } from '@/features/plan/plan';

  const section = document.querySelector<HTMLElement>('#whats-included')!;
  let kind = 'kitchen';
  let service: string = loadSelection(getStorage(), pricing, rooms.max)?.service ?? 'regular';

  const stageBlock = section.querySelector<HTMLElement>('[data-stage-block]');
  const stageRooms = [...section.querySelectorAll<HTMLElement>('[data-stage-room]')];

  const show = () => {
    section.querySelectorAll<HTMLElement>('[data-room-panel]').forEach((p) => {
      p.hidden = !(p.dataset.roomKind === kind && p.dataset.service === service);
    });
    // The stage shows the same room. A room with no pictures has no stage: the checklist is all there is, as before.
    stageRooms.forEach((r) => (r.hidden = r.dataset.stageRoom !== kind));
    if (stageBlock) stageBlock.hidden = !stageRooms.some((r) => r.dataset.stageRoom === kind);
  };

  section.addEventListener(ROOM_EVENT, (e) => {
    kind = (e as CustomEvent<{ kind: string }>).detail.kind;
    show();
  });
  onSelection((s) => {
    service = s.service;
    show();
  });
  show();
</script>

<style>
  .included {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
  }
  .included__plan {
    display: grid;
    gap: var(--space-5);
  }
  .panel {
    display: grid;
    gap: var(--space-1);
  }
  .panel__service {
    color: var(--color-ink-muted);
  }
  .panel ul {
    display: grid;
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
  }
  .panel li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-bottom: var(--hairline) solid var(--color-line);
  }
  @media (min-width: 900px) {
    .included {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: var(--space-8);
    }
    /* Beside the stage the plan is the room picker, so it stays the size it is on a phone. */
    .included__map {
      max-width: 20rem;
    }
  }
  /* Tall desktop screens: the plan, stage and checklist hold still for 120vh of scrolling while the stage
     plays (spec §5.5). Only where the whole block fits under the header, never under reduced motion, and
     only once the stage's script is running (.is-live), so nothing pins without a show to watch.
     stage.ts reads `position` to know which way to measure, so this rule is the only switch. */
  @media screen and (min-width: 64em) and (min-height: 48.75em) and (prefers-reduced-motion: no-preference) {
    .included:global(:has(.stage.is-live)) {
      position: sticky;
      top: 5.5rem;
    }
    .included__track:global(:has(.stage.is-live))::after {
      content: '';
      display: block;
      height: 120vh;
    }
  }
</style>
