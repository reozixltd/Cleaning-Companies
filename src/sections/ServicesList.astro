---
/** The four home services as a list: photo, one line, from price. Not a card grid. */
import { getCollection } from 'astro:content';
import { photoSlots } from '@/config/photo-slots';
import { pricing } from '@/config/pricing';
import { formatMoney } from '@/core/format';
import { fromPrice } from '@/domain/quote';
import Photo from '@/core/ui/Photo.astro';
import SectionHead from './SectionHead.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<section class="band" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <SectionHead id="services-title" title="Cleans we do" intro="Every price includes GST, supplies and equipment." />
    <ul class="services" role="list">
      {services.map((s) => {
        const slot = `service-${s.data.service}` as keyof typeof photoSlots;
        return (
          <li class="service">
            <Photo slot={slot} alt={photoSlots[slot].alt} ratio="3 / 2" sizes="(min-width: 900px) 280px, 100vw" class="service__photo" />
            <div class="service__body">
              <h3><a href={`/services/${s.id}/`}>{s.data.title}</a></h3>
              <p>{s.data.summary}</p>
            </div>
            <p class="service__price">from <strong class="tabular">{formatMoney(fromPrice(s.data.service, pricing))}</strong></p>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .services {
    display: grid;
    padding: 0;
    list-style: none;
    border-top: var(--wall) solid var(--color-ink);
  }
  .service {
    position: relative;
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-bottom: var(--hairline) solid var(--color-line);
  }
  .service__body {
    display: grid;
    gap: var(--space-2);
  }
  .service h3 a {
    text-decoration: none;
  }
  .service h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .service__body p {
    color: var(--color-ink-muted);
  }
  .service__price {
    font-size: var(--text-18);
  }
  .service__price strong {
    font-size: var(--text-28);
  }
  @media (min-width: 900px) {
    .service {
      grid-template-columns: 240px minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-6);
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .service:hover h3 a {
      text-decoration: underline;
      text-decoration-thickness: var(--wall);
    }
  }
</style>
