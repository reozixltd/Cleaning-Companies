---
/** The four home services as cards: photo, one line, from price. */
import { getCollection } from 'astro:content';
import { photoSlots } from '@/config/photo-slots';
import { pricing } from '@/config/pricing';
import { formatMoney } from '@/core/format';
import { fromPrice } from '@/domain/quote';
import Photo from '@/core/ui/Photo.astro';
import SectionHead from './SectionHead.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<section class="band" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <SectionHead id="services-title" title="Cleans we do" intro="Every price includes GST, supplies and equipment." />
    <ul class="services" role="list">
      {services.map((s) => {
        const slot = `service-${s.data.service}` as keyof typeof photoSlots;
        return (
          <li class="service card">
            <Photo slot={slot} alt={photoSlots[slot].alt} ratio="3 / 2" sizes="(min-width: 1200px) 280px, (min-width: 768px) 45vw, 100vw" class="service__photo" />
            <div class="service__body">
              <h3><a href={`/services/${s.id}/`}>{s.data.title}</a></h3>
              <p>{s.data.summary}</p>
            </div>
            <p class="service__price">from <strong class="tabular">{formatMoney(fromPrice(s.data.service, pricing))}</strong></p>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .services {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }
  .service {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-4);
    transition: border-color var(--dur-colour) ease;
  }
  .service__body {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .service h3 {
    font-size: var(--text-20);
  }
  .service h3 a {
    text-decoration: none;
  }
  .service h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .service__body p {
    font-size: var(--text-14);
  }
  .service__price {
    font-size: var(--text-14);
  }
  .service__price strong {
    color: var(--color-ink);
    font-size: var(--text-22);
  }
  .service__price::after {
    content: '\2192';
    float: right;
    color: var(--color-ink);
    font-size: var(--text-18);
  }
  @media (min-width: 768px) {
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1200px) {
    .services {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .service:hover {
      border-color: var(--color-ink);
    }
    .service:hover h3 a {
      text-decoration: underline;
    }
  }
</style>
