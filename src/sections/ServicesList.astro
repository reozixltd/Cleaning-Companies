---
/** The four home services as photo cards: photo, one line, from price. Two across on a desktop. */
import { getCollection } from 'astro:content';
import { photoSlots } from '@/config/photo-slots';
import { pricing } from '@/config/pricing';
import { formatMoney } from '@/core/format';
import { fromPrice } from '@/domain/quote';
import Photo from '@/core/ui/Photo.astro';
import SectionHead from './SectionHead.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<section class="band" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <SectionHead id="services-title" title="Cleans we do" intro="Every price includes GST, supplies and equipment." />
    <ul class="services" role="list" data-progress>
      {services.map((s, i) => {
        const slot = `service-${s.data.service}` as keyof typeof photoSlots;
        return (
          <li data-reveal data-tilt style={`--i: ${i % 2}`}>
            <div class="service">
              <Photo slot={slot} alt={photoSlots[slot].alt} ratio="3 / 2" sizes="(min-width: 900px) 560px, 100vw" class="service__photo" />
              <div class="service__body">
                <h3><a href={`/services/${s.id}/`}>{s.data.title}</a></h3>
                <p>{s.data.summary}</p>
              </div>
              <p class="service__price">from <strong class="tabular">{formatMoney(fromPrice(s.data.service, pricing))}</strong></p>
            </div>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<script>
  // Fine pointers only: a card leans up to 4° toward the pointer, with a soft sheen where it points.
  // The listener sits on the list item, which never tilts, so the leaning card cannot pull its own edge out from under the pointer.
  // Touch screens and reduced motion keep the flat card; nothing here is needed to read or use it.
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const card of document.querySelectorAll<HTMLElement>('[data-tilt]')) {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = Math.min(Math.max((e.clientX - r.left) / r.width, 0), 1);
        const y = Math.min(Math.max((e.clientY - r.top) / r.height, 0), 1);
        // The sheen covers the photo only, so its height is measured against the photo, not the whole card.
        const photo = card.querySelector<HTMLElement>('.service__photo')!.getBoundingClientRect();
        card.style.setProperty('--tilt-x', `${((0.5 - y) * 8).toFixed(2)}deg`);
        card.style.setProperty('--tilt-y', `${((x - 0.5) * 8).toFixed(2)}deg`);
        card.style.setProperty('--sheen-x', `${(x * 100).toFixed(1)}%`);
        card.style.setProperty('--sheen-y', `${(((e.clientY - photo.top) / photo.height) * 100).toFixed(1)}%`);
      });
      card.addEventListener('pointerleave', () => {
        card.style.removeProperty('--tilt-x');
        card.style.removeProperty('--tilt-y');
      });
    }
  }
</script>

<style>
  .services {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }
  .service {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-4);
    height: 100%;
    padding-bottom: var(--space-5);
    overflow: hidden;
    background: var(--color-surface);
    border-radius: var(--radius-control);
    box-shadow: var(--shadow-1);
  }
  /* The sheen: a soft light on the photo where the pointer is. It never takes a click. */
  .service::after {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    aspect-ratio: 3 / 2;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle at var(--sheen-x, 50%) var(--sheen-y, 50%), color-mix(in srgb, var(--color-surface) 35%, transparent), transparent 55%);
    transition: opacity var(--dur-colour) linear;
  }
  .service :global(.service__photo) {
    border-radius: 0;
  }
  /* The photo drifts inside its frame as the list crosses the screen. */
  @media screen {
    :global(.motion) .service :global(.service__photo img) {
      transform: scale(1.12) translateY(calc((0.5 - var(--p)) * 6%));
    }
  }
  .service__body {
    display: grid;
    gap: var(--space-2);
    padding-inline: var(--space-5);
  }
  .service h3 a {
    text-decoration: none;
  }
  /* The whole card is the link's target. */
  .service h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .service__body p {
    color: var(--color-ink-muted);
  }
  .service__price {
    padding-inline: var(--space-5);
    font-size: var(--text-18);
  }
  .service__price strong {
    font-size: var(--text-28);
  }
  @media (min-width: 900px) {
    .services {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-6);
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .service {
      transform: perspective(60rem) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
      transition: transform var(--dur-fill) var(--ease-out);
    }
    li:hover .service::after {
      opacity: 1;
    }
    li:hover .service h3 a {
      text-decoration: underline;
      text-decoration-thickness: var(--wall);
    }
  }
</style>
