---
/** "Who comes to your home": the answer to the stranger-in-my-house worry, with the founder's face and words. */
import { getEntry } from 'astro:content';
import { business } from '@/config/business';
import { photoSlots } from '@/config/photo-slots';
import { hasPhoto } from '@/core/photos';
import Photo from '@/core/ui/Photo.astro';
import Icon from '@/core/ui/Icon.astro';
import SectionHead from './SectionHead.astro';

const founder = (await getEntry('team', 'mel'))!.data;
const checks = [
  `${business.policeChecked}, renewed every three years.`,
  'Each one passes an interview and a paid trial clean with a team lead.',
  'They are our employees, not subcontractors, covered by our insurance and workers’ compensation.',
  'You get the same cleaner each visit whenever we can, with notes on how you like things done.',
];
---

<section class="band vetting" id="team" aria-labelledby="team-title">
  <div class="wrap vetting__grid">
    <div class="vetting__checks">
      <SectionHead id="team-title" title="Who comes to your home" />
      <ul class="checks" role="list">
        {checks.map((c, i) => <li data-reveal style={`--i: ${i}`}><Icon name="check" size={22} />{c}</li>)}
      </ul>
      {
        hasPhoto('team') && (
          <div class="sampled vetting__team" data-reveal>
            <Photo slot="team" alt={photoSlots.team.alt} ratio="3 / 2" sizes="(min-width: 900px) 752px, 100vw" />
            {business.demoMode && <span class="sample-tag">Sample photo</span>}
          </div>
        )
      }
    </div>
    <figure class="founder" data-reveal>
      <div class="sampled">
        <Photo slot="founder" alt={`${founder.name}, ${founder.role}`} label={`${founder.name}, ${founder.role}`} ratio="4 / 5" sizes="(min-width: 900px) 320px, 100vw" />
        {business.demoMode && hasPhoto('founder') && <span class="sample-tag">Sample photo</span>}
      </div>
      <blockquote>{founder.note}</blockquote>
      <figcaption>{founder.name}, {founder.role.toLowerCase()} since {founder.since}</figcaption>
    </figure>
  </div>
</section>

<style>
  .vetting {
    background: var(--color-surface);
    border-block: var(--hairline) solid var(--color-line);
  }
  .vetting__grid {
    display: grid;
    gap: var(--space-7);
  }
  .checks {
    display: grid;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }
  .checks li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    font-size: var(--text-18);
  }
  /* Each check ticks in a beat after its line rises. */
  @media screen {
    :global(.motion) .checks li :global(.icon) {
      opacity: 0;
      transform: scale(0.4);
    }
    :global(.motion) .checks li.is-in :global(.icon) {
      opacity: 1;
      transform: none;
      transition: opacity var(--dur-reveal) var(--ease-out), transform var(--dur-reveal) var(--ease-out);
      transition-delay: calc(var(--i, 0) * 80ms + 250ms);
    }
  }
  .vetting__team {
    margin-top: var(--space-6);
  }
  .founder {
    display: grid;
    gap: var(--space-3);
    max-width: 360px;
    align-self: start;
  }
  .founder blockquote {
    margin: 0;
    font-size: var(--text-18);
  }
  .founder figcaption {
    color: var(--color-ink-muted);
  }
  @media (min-width: 900px) {
    .vetting__grid {
      grid-template-columns: minmax(0, 1fr) 320px;
      gap: var(--space-8);
    }
  }
</style>
